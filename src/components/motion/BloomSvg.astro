---
interface Props {
  class?: string;
  size?: number;
  petalCount?: number;
  /** Petal fill; defaults to rose. */
  color?: string;
}

const {
  class: className = "",
  size = 80,
  petalCount = 6,
  color = "var(--color-rose)",
} = Astro.props;

const petals = Array.from({ length: petalCount }, (_, i) => ({
  angle: (360 / petalCount) * i,
  delay: i * 0.12,
}));
---

<flora-bloom class={`inline-block ${className}`}>
  <svg viewBox="0 0 100 100" width={size} height={size} aria-hidden="true" class="block">
    <g transform="translate(50,50)">
      {petals.map((p) => (
        // Rotation lives on the wrapper: a CSS transform on the ellipse itself
        // would replace its SVG transform attribute and stack every petal.
        <g transform={`rotate(${p.angle})`}>
          <ellipse
            cx="0"
            cy="-18"
            rx="8"
            ry="18"
            fill={color}
            fill-opacity="0.5"
            class="flora-bloom-part"
            style={`--flora-bloom-delay: ${p.delay}s`}
          />
        </g>
      ))}
      <circle
        r="6"
        fill="var(--color-gold)"
        fill-opacity="0.8"
        class="flora-bloom-part"
        style={`--flora-bloom-delay: ${petalCount * 0.12 + 0.1}s`}
      />
    </g>
  </svg>
</flora-bloom>

<style>
  .flora-bloom-part {
    transform-origin: 0 0;
  }
  :global(.js) .flora-bloom-part {
    opacity: 0;
  }
  flora-bloom[data-bloomed] .flora-bloom-part {
    animation: flora-bloom 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--flora-bloom-delay, 0s) forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .flora-bloom-part {
      opacity: 1;
      animation: none !important;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        (entry.target as HTMLElement).dataset.bloomed = "";
        observer.unobserve(entry.target);
      }
    },
    { threshold: 0.5 },
  );

  class FloraBloom extends HTMLElement {
    connectedCallback() {
      observer.observe(this);
    }
    disconnectedCallback() {
      observer.unobserve(this);
    }
  }

  customElements.define("flora-bloom", FloraBloom);
</script>
