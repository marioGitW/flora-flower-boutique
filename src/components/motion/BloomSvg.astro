---
interface Props {
  class?: string;
  size?: number;
  petalCount?: number;
}

const { class: className = "", size = 80, petalCount = 6 } = Astro.props;

const petals = Array.from({ length: petalCount }, (_, i) => ({
  angle: (360 / petalCount) * i,
  delay: i * 0.12,
}));
---

<flora-bloom class={`inline-block ${className}`}>
  <svg
    viewBox="0 0 100 100"
    width={size}
    height={size}
    aria-hidden="true"
    class="flora-bloom-svg"
  >
    <g transform="translate(50,50)">
      {petals.map((p) => (
        <ellipse
          cx="0"
          cy="-18"
          rx="8"
          ry="18"
          fill="var(--color-rose)"
          opacity="0.5"
          transform={`rotate(${p.angle})`}
          class="flora-bloom-petal"
          style={`
            transform-origin: center center;
            opacity: 0;
            animation-delay: ${p.delay}s;
          `}
        />
      ))}
      <circle cx="0" cy="0" r="6" fill="var(--color-gold)" opacity="0.8" class="flora-bloom-center" style="opacity: 0;" />
    </g>
  </svg>
</flora-bloom>

<script>
  class FloraBloom extends HTMLElement {
    private observer: IntersectionObserver | null = null;

    connectedCallback() {
      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (prefersReduced) {
        this.querySelectorAll<SVGElement>(".flora-bloom-petal, .flora-bloom-center").forEach((el) => {
          el.style.opacity = "1";
          el.style.transform = el.getAttribute("transform") || "";
        });
        return;
      }

      this.observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;

          this.querySelectorAll<SVGElement>(".flora-bloom-petal").forEach((petal) => {
            petal.style.animation = `flora-bloom 0.6s cubic-bezier(0.22, 1, 0.36, 1) ${petal.style.animationDelay} forwards`;
          });

          const center = this.querySelector<SVGElement>(".flora-bloom-center");
          if (center) {
            const petalCount = this.querySelectorAll(".flora-bloom-petal").length;
            center.style.animation = `flora-bloom 0.4s cubic-bezier(0.22, 1, 0.36, 1) ${petalCount * 0.12 + 0.1}s forwards`;
          }

          this.observer?.unobserve(this);
        },
        { threshold: 0.5 },
      );
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }

  customElements.define("flora-bloom", FloraBloom);
</script>
