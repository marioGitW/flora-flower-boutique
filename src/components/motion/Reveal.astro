---
/**
 * Wraps content in a scroll-revealed element. The behaviour lives in
 * src/scripts/reveal.ts and global.css; this only saves writing the attribute
 * by hand. Put `data-reveal` straight on an element when a wrapper would get
 * in the way (grid items, images).
 */
interface Props {
  class?: string;
  /** ms before the entrance starts, for sequencing within a block. */
  delay?: number;
}

const { class: className = "", delay = 0 } = Astro.props;
---

<div class={className} data-reveal style={delay ? `--reveal-delay: ${delay}ms` : undefined}>
  <slot />
</div>
