---
import { site } from "../../data/site";
import { copy } from "../../data/copy";
import PetalField from "../motion/PetalField.astro";
import Reveal from "../motion/Reveal.astro";
import BloomSvg from "../motion/BloomSvg.astro";
import ContactIcon from "../ui/ContactIcon.astro";
---

<section class="relative min-h-[85dvh] flex items-center overflow-hidden bg-cream" aria-label="Почетна">
  <PetalField count={10} />

  <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 text-center">
    <Reveal>
      <BloomSvg size={64} petalCount={6} class="mx-auto mb-6" />
    </Reveal>

    <Reveal delay={100}>
      <h1 class="font-display text-5xl md:text-6xl text-ink leading-tight">
        {site.name}
      </h1>
    </Reveal>

    <Reveal delay={200}>
      <p class="mt-2 font-display text-lg md:text-xl text-rose-ink">
        {copy.hero.kind}
      </p>
    </Reveal>

    <Reveal delay={350}>
      <p class="mx-auto mt-6 max-w-md font-display text-xl text-ink">
        {site.tagline}
      </p>
    </Reveal>

    <Reveal delay={450}>
      <p class="mx-auto mt-3 max-w-md text-base text-ink/75">
        {copy.hero.lead}
      </p>
    </Reveal>

    <!-- Not wrapped in Reveal: the call/Viber buttons must be usable on first paint, with or without JS. -->
    <div class="mx-auto mt-8 grid max-w-xs gap-3 sm:max-w-lg sm:grid-cols-2">
      <a
        href={site.phoneHref}
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded bg-rose-ink px-5 py-3 text-base font-medium text-cream transition-colors hover:bg-rose-ink-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-ink"
      >
        <ContactIcon name="phone" />
        {copy.hero.callLabel} {site.phoneFormatted}
      </a>
      <a
        href={site.viberHref}
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded bg-viber px-5 py-3 text-base font-medium text-cream transition-colors hover:bg-viber-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-viber"
      >
        <ContactIcon name="viber" />
        {copy.hero.viberLabel}
      </a>
    </div>
  </div>
</section>
