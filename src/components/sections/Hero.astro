---
import { Picture, Image } from "astro:assets";
import { site } from "../../data/site";
import { copy } from "../../data/copy";
import { images } from "../../data/images";
import PetalField from "../motion/PetalField.astro";
import Reveal from "../motion/Reveal.astro";
import ContactIcon from "../ui/ContactIcon.astro";
---

{/*
  The photo is its own sticky layer, outside the section: it stays pinned while the
  hero text scrolls away at normal speed (no parallax on text) and the next section
  slides up over it. Its sticky range is the wrapper around Hero + Services in
  index.astro. Full-bleed on mobile, right-hand bleed from lg.
*/}
<div class="flora-hero-media sticky top-0 z-0 -mb-[100svh] h-[100svh] overflow-hidden" data-hero-media>
  <div class="flora-hero-zoom absolute inset-0 lg:left-1/2">
    <Picture
      src={images.hero}
      alt=""
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[390, 560, 741]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      quality={55}
      loading="eager"
      class="h-full w-full object-cover object-[50%_30%]"
    />
    {/* Warm cream veil keeps text AA over the photo on mobile; on desktop the text sits on plain cream. */}
    <div class="flora-hero-veil absolute inset-0 lg:hidden" aria-hidden="true"></div>
    {/* Inside the zoom layer so it recedes with the photo instead of framing it. */}
    <div class="flora-hero-shade absolute inset-0 bg-ink opacity-0" aria-hidden="true"></div>
  </div>
</div>

<section
  id="pocetok"
  class="flora-hero relative z-10 flex min-h-[92svh] items-center overflow-hidden lg:min-h-[100svh]"
  aria-labelledby="hero-title"
>
  <PetalField count={8} class="opacity-60 lg:right-1/2" />

  <div class="relative mx-auto w-full max-w-6xl px-4 pb-16 pt-24 lg:grid lg:grid-cols-2 lg:pb-24 lg:pt-28">
    <div class="mx-auto max-w-md text-center lg:mx-0 lg:max-w-lg lg:pr-12 lg:text-left">
      <Reveal>
        {/* WebP, not AVIF: the watercolour-with-alpha logo compresses worse as AVIF. */}
        <Image
          src={images.logo}
          alt=""
          format="webp"
          widths={[112, 224]}
          sizes="112px"
          width={112}
          height={112}
          quality={65}
          loading="eager"
          class="mx-auto mb-2 h-28 w-28 lg:mx-0 lg:-ml-2"
        />
      </Reveal>

      <Reveal delay={80}>
        <h1 id="hero-title" class="font-display text-6xl leading-none text-ink lg:text-7xl">
          {site.name}
        </h1>
      </Reveal>

      <Reveal delay={160}>
        <p class="mt-3 font-display text-2xl text-rose-ink lg:text-3xl">{copy.hero.kind}</p>
      </Reveal>

      <Reveal delay={240}>
        <p class="mt-6 font-display text-xl leading-snug text-ink lg:text-2xl">
          {site.tagline}
        </p>
      </Reveal>

      <Reveal delay={320}>
        <p class="mt-3 text-base leading-relaxed text-ink/90 lg:text-lg">{copy.hero.lead}</p>
      </Reveal>

      {/* Not wrapped in Reveal: the call/Viber buttons must be usable on first paint, with or without JS. */}
      <div class="mx-auto mt-8 grid max-w-xs gap-3 whitespace-nowrap sm:w-fit sm:max-w-none sm:grid-cols-2 lg:mx-0" data-hero-ctas>
        <a
          href={site.phoneHref}
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded bg-rose-ink px-5 py-3 text-base font-medium text-cream shadow-sm transition-colors hover:bg-rose-ink-hover"
        >
          <ContactIcon name="phone" />
          {copy.hero.callLabel} {site.phoneFormatted}
        </a>
        <a
          href={site.viberHref}
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded bg-viber px-5 py-3 text-base font-medium text-cream shadow-sm transition-colors hover:bg-viber-hover"
        >
          <ContactIcon name="viber" />
          {copy.hero.viberLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .flora-hero-zoom {
    transform-origin: 50% 35%;
  }

  /* Scroll-linked recede: transform/opacity only, driven by the compositor where supported. */
  @keyframes flora-hero-recede {
    to {
      transform: scale(0.92);
    }
  }
  @keyframes flora-hero-shade {
    to {
      opacity: 0.45;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .flora-hero-zoom {
        animation: flora-hero-recede linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100svh;
      }
      /* Darkening starts a little later so text still on screen keeps its contrast. */
      .flora-hero-shade {
        animation: flora-hero-shade linear both;
        animation-timeline: scroll(root);
        animation-range: 25svh 100svh;
      }
    }
  }

  .flora-hero-veil {
    background:
      linear-gradient(
        to bottom,
        rgb(251 247 242 / 0.5) 0%,
        rgb(251 247 242 / 0.8) 30%,
        rgb(251 247 242 / 0.86) 70%,
        rgb(251 247 242 / 1) 100%
      ),
      rgb(244 221 220 / 0.18);
  }
</style>

<script>
  // Fallback for browsers without scroll-driven animations: same effect via rAF,
  // listening to scroll only while the photo is on screen.
  const media = document.querySelector<HTMLElement>("[data-hero-media]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (media && !reduced && !CSS.supports("animation-timeline: scroll()")) {
    const zoom = media.querySelector<HTMLElement>(".flora-hero-zoom")!;
    const shade = media.querySelector<HTMLElement>(".flora-hero-shade")!;
    let queued = false;

    const update = () => {
      queued = false;
      const vh = window.innerHeight;
      const clamp = (v: number) => Math.min(1, Math.max(0, v));
      const p = clamp(window.scrollY / vh);
      const q = clamp((window.scrollY - 0.25 * vh) / (0.75 * vh));
      zoom.style.transform = `scale(${1 - 0.08 * p})`;
      shade.style.opacity = String(0.45 * q);
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        window.addEventListener("scroll", onScroll, { passive: true });
        update();
      } else {
        window.removeEventListener("scroll", onScroll);
      }
    }).observe(media);
  }
</script>
