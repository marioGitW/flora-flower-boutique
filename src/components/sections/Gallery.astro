---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { copy } from "../../data/copy";
import SectionHeading from "../ui/SectionHeading.astro";
import Lightbox from "../ui/Lightbox.astro";
import SectionDivider from "../ui/SectionDivider.astro";
import DeferredPicture from "../ui/DeferredPicture.astro";

const gallery = await getCollection("gallery");
const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);

// Chips follow services.json order; a category shows up once it has a photo.
const chips = services
  .map((s) => ({ id: s.id, name: s.data.name, count: gallery.filter((g) => g.data.category === s.id).length }))
  .filter((c) => c.count > 0);

const wells = ["bg-blush", "bg-mint", "bg-butter", "bg-lilac"];
// Extra rows under each tile, in 1/100-column units — acts as the vertical gap.
const GAP_ROWS = 5;

const thumbWidths = [240, 360, 480, 720];
const thumbSizes =
  "(min-width: 1280px) 290px, (min-width: 1024px) calc((100vw - 92px) / 4), (min-width: 640px) calc((100vw - 64px) / 3), calc((100vw - 44px) / 2)";

const items = await Promise.all(
  gallery.map(async (item, i) => {
    const { src, alt, category } = item.data;
    const full = await getImage({ src, format: "webp", quality: 80 });
    return {
      src,
      alt,
      category,
      fullSrc: full.src,
      w: src.width,
      h: src.height,
      span: Math.ceil((100 * src.height) / src.width) + GAP_ROWS,
      well: wells[i % wells.length],
    };
  }),
);
---

<section id="galerija" class="bg-cream pb-20 lg:pb-28" aria-labelledby="galerija-title">
  <SectionDivider class="mb-12 lg:mb-16" />
  <div class="mx-auto max-w-7xl px-4">
    <SectionHeading id="galerija-title" title={copy.gallery.heading} intro={copy.gallery.intro} />

    <flora-gallery class="mt-10 block">
      <div
        class="js-only sticky top-16 z-20 -mx-4 bg-cream/95 px-3 py-2 backdrop-blur-sm lg:static lg:bg-transparent lg:backdrop-blur-none"
        role="group"
        aria-label={copy.gallery.filterLabel}
      >
        <div class="flora-chips flex gap-2 overflow-x-auto p-1 lg:flex-wrap lg:justify-center lg:overflow-visible">
          <button type="button" class="flora-chip" data-filter="*" aria-pressed="true">
            {copy.gallery.filterAll}
          </button>
          {chips.map((c) => (
            <button type="button" class="flora-chip" data-filter={c.id} aria-pressed="false">
              {c.name}
            </button>
          ))}
        </div>
      </div>

      <div class="flora-masonry-wrap mt-4 lg:mt-8">
        <ul class="flora-masonry flora-gallery-grid" role="list">
          {items.map((item) => (
            <li style={`--span: ${item.span}`} data-category={item.category}>
              <a
                href={item.fullSrc}
                data-lightbox
                data-w={item.w}
                data-h={item.h}
                data-alt={item.alt}
                class:list={["flora-panel flora-tile group relative block overflow-hidden rounded", item.well]}
                style={`aspect-ratio: ${item.w} / ${item.h}`}
                aria-label={`${copy.gallery.open} ${item.alt}`}
              >
                <DeferredPicture
                  src={item.src}
                  alt={item.alt}
                  widths={thumbWidths}
                  sizes={thumbSizes}
                  quality={68}
                  class="block h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </flora-gallery>
  </div>

  <Lightbox />
</section>

<style>
  .flora-chips {
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  .flora-chips::-webkit-scrollbar {
    display: none;
  }
  .flora-chip {
    flex: none;
    scroll-snap-align: start;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid rgb(58 51 48 / 0.18);
    background: var(--color-cream);
    color: var(--color-ink);
    font-size: 0.9375rem;
    white-space: nowrap;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .flora-chip:hover {
    border-color: var(--color-rose-ink);
  }
  .flora-chip[aria-pressed="true"] {
    background: var(--color-rose-ink);
    border-color: var(--color-rose-ink);
    color: var(--color-cream);
  }
  .flora-gallery-grid {
    transition: opacity 0.18s ease;
  }

  /* Enter: tile fades in while its photo settles from 1.04 to 1. Rows are staggered
     via --flora-row-delay. Fill is "backwards" so the hover zoom still works after. */
  :global(.js) .flora-tile {
    opacity: 0;
  }
  .flora-tile.is-in {
    opacity: 1;
    animation: flora-tile-fade 0.9s ease-out var(--flora-row-delay, 0ms) backwards;
  }
  .flora-tile.is-in :global(img) {
    animation: flora-tile-settle 1.4s cubic-bezier(0.22, 1, 0.36, 1) var(--flora-row-delay, 0ms) backwards;
  }
  @keyframes flora-tile-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes flora-tile-settle {
    from {
      transform: scale(1.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .flora-tile {
      opacity: 1;
    }
    .flora-tile.is-in,
    .flora-tile.is-in :global(img) {
      animation: none;
    }
  }
  .flora-gallery-grid.is-filtering {
    opacity: 0;
  }
</style>

<script>
  class FloraGallery extends HTMLElement {
    connectedCallback() {
      const grid = this.querySelector<HTMLElement>(".flora-gallery-grid");
      const bar = this.querySelector<HTMLElement>("[role=group]");
      const chips = [...this.querySelectorAll<HTMLButtonElement>("[data-filter]")];
      if (!grid || !bar) return;
      const tiles = [...grid.children] as HTMLElement[];
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Enter animation, once per tile. Tiles arriving together are grouped into
      // visual rows by their top edge; each row starts 90ms after the one above.
      const enter = new IntersectionObserver(
        (entries) => {
          const arriving = entries
            .filter((e) => e.isIntersecting)
            .map((e) => ({ el: e.target as HTMLElement, top: e.boundingClientRect.top }))
            .sort((a, b) => a.top - b.top);
          let row = -1;
          let rowTop = -Infinity;
          for (const { el, top } of arriving) {
            if (top - rowTop > 48) {
              row += 1;
              rowTop = top;
            }
            el.style.setProperty("--flora-row-delay", `${row * 90}ms`);
            el.classList.add("is-in");
            enter.unobserve(el);
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -6% 0px" },
      );
      for (const li of tiles) {
        const tile = li.querySelector<HTMLElement>(".flora-tile");
        if (tile) enter.observe(tile);
      }

      const apply = (filter: string) => {
        for (const li of tiles) li.hidden = filter !== "*" && li.dataset.category !== filter;
      };

      for (const chip of chips) {
        chip.addEventListener("click", () => {
          if (chip.getAttribute("aria-pressed") === "true") return;
          for (const c of chips) c.setAttribute("aria-pressed", String(c === chip));

          // Keep the chips where the thumb is: if the bar is stuck, bring the
          // grid top back under it so a shorter result can't strand the viewport.
          const barBottom = bar.getBoundingClientRect().bottom;
          const gridTop = grid.getBoundingClientRect().top;
          const realign = gridTop < barBottom - 1;

          const swap = () => {
            apply(chip.dataset.filter ?? "*");
            if (realign) {
              window.scrollTo({ top: window.scrollY + grid.getBoundingClientRect().top - barBottom - 8, behavior: "instant" });
            }
            grid.classList.remove("is-filtering");
          };

          if (reduced) return swap();
          grid.classList.add("is-filtering");
          setTimeout(swap, 180);
        });
      }
    }
  }

  customElements.define("flora-gallery", FloraGallery);
</script>
