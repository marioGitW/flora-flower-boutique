---
import { getCollection } from "astro:content";
import Reveal from "../motion/Reveal.astro";
import DrawLine from "../motion/DrawLine.astro";
import Lightbox from "../ui/Lightbox.astro";

const gallery = await getCollection("gallery");
---

<section id="galerija" class="bg-cream py-16 md:py-24" aria-label="Галерија">
  <div class="mx-auto max-w-6xl px-4">
    <Reveal>
      <h2 class="font-display text-3xl md:text-4xl text-center text-ink">Галерија</h2>
    </Reveal>

    <Reveal delay={100}>
      <DrawLine class="mx-auto mt-4 max-w-[200px]" />
    </Reveal>

    <Reveal delay={200}>
      <p class="mx-auto mt-6 max-w-lg text-center text-ink/70">
        Секој аранжман е уникатен — изработен со внимание и љубов.
      </p>
    </Reveal>

    <Lightbox class="mt-12">
      <div class="columns-2 gap-4 sm:columns-3 lg:columns-4">
        {gallery.map((item, i) => (
          <Reveal delay={i * 40}>
            <button
              class="mb-4 block w-full overflow-hidden rounded cursor-pointer border-0 p-0 bg-mint/30"
              data-lightbox-src={item.data.src}
              data-lightbox-alt={item.data.alt}
              style={`aspect-ratio: ${item.data.width}/${item.data.height}`}
              aria-label={`Отвори: ${item.data.alt}`}
            >
              <img
                src={item.data.src}
                alt={item.data.alt}
                width={item.data.width}
                height={item.data.height}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
              />
            </button>
          </Reveal>
        ))}
      </div>
    </Lightbox>
  </div>
</section>
