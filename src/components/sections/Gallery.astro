---
import { getCollection } from "astro:content";
import { Picture, getImage } from "astro:assets";
import Reveal from "../motion/Reveal.astro";
import DrawLine from "../motion/DrawLine.astro";
import Lightbox from "../ui/Lightbox.astro";
import { copy } from "../../data/copy";

const gallery = await getCollection("gallery");

// Don't read properties off item.data.src here: any access marks the original
// as referenced and Astro then copies the full PNG into dist.
const thumbWidths = [240, 360, 480, 720];
const thumbSizes =
  "(min-width: 1024px) 270px, (min-width: 640px) calc((100vw - 64px) / 3), calc((100vw - 48px) / 2)";

const items = await Promise.all(
  gallery.map(async (item) => {
    const full = await getImage({ src: item.data.src, format: "webp", quality: 80 });
    return { ...item.data, fullSrc: full.src };
  }),
);
---

<section id="galerija" class="bg-cream py-16 md:py-24" aria-label={copy.gallery.heading}>
  <div class="mx-auto max-w-6xl px-4">
    <Reveal>
      <h2 class="font-display text-3xl md:text-4xl text-center text-ink">{copy.gallery.heading}</h2>
    </Reveal>

    <Reveal delay={100}>
      <DrawLine class="mx-auto mt-4 max-w-[200px]" />
    </Reveal>

    <Reveal delay={200}>
      <p class="mx-auto mt-6 max-w-lg text-center text-ink/70">
        {copy.gallery.intro}
      </p>
    </Reveal>

    <Lightbox class="mt-12">
      <div class="columns-2 gap-4 sm:columns-3 lg:columns-4">
        {items.map((item, i) => (
          <Reveal delay={i * 40} class="mb-4 break-inside-avoid">
            <button
              class="block w-full overflow-hidden rounded cursor-pointer border-0 p-0 bg-mint/30"
              data-lightbox-src={item.fullSrc}
              data-lightbox-alt={item.alt}
              aria-label={`${copy.gallery.open} ${item.alt}`}
            >
              <Picture
                src={item.src}
                alt={item.alt}
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={thumbWidths}
                sizes={thumbSizes}
                quality={75}
                loading="lazy"
                decoding="async"
                class="block h-auto w-full transition-transform duration-300 hover:scale-105"
              />
            </button>
          </Reveal>
        ))}
      </div>
    </Lightbox>
  </div>
</section>
