---
import { site } from "../../data/site";
import { copy } from "../../data/copy";
import Reveal from "../motion/Reveal.astro";
import DrawLine from "../motion/DrawLine.astro";

const steps = copy.howToOrder.steps.map((step, i) => ({
  ...step,
  num: String(i + 1).padStart(2, "0"),
}));
---

<section id="kako-naracuvate" class="bg-mint/30 py-16 md:py-24" aria-label={copy.howToOrder.heading}>
  <div class="mx-auto max-w-6xl px-4">
    <Reveal>
      <h2 class="font-display text-3xl md:text-4xl text-center text-ink">
        {copy.howToOrder.heading}
      </h2>
    </Reveal>

    <Reveal delay={100}>
      <DrawLine class="mx-auto mt-4 max-w-[200px]" />
    </Reveal>

    <Reveal delay={200}>
      <p class="mx-auto mt-6 max-w-lg text-center text-ink/75">
        {copy.howToOrder.intro}
      </p>
    </Reveal>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {steps.map((step, i) => (
        <Reveal delay={i * 120}>
          <div class="text-center">
            <span class="font-display text-4xl text-rose/40">{step.num}</span>
            <h3 class="mt-2 font-display text-xl text-ink">{step.title}</h3>
            <p class="mt-2 text-ink/70">{step.text}</p>
          </div>
        </Reveal>
      ))}
    </div>

    <Reveal delay={400}>
      <div class="mt-10 text-center">
        <a
          href={site.phoneHref}
          class="inline-flex items-center justify-center rounded bg-rose px-6 py-3 text-base font-medium text-cream transition-colors hover:bg-rose-deep"
        >
          {copy.howToOrder.cta} {site.phoneFormatted}
        </a>
      </div>
    </Reveal>
  </div>
</section>
