---
import { site } from "../../data/site";
import Reveal from "../motion/Reveal.astro";
import DrawLine from "../motion/DrawLine.astro";

const steps = [
  {
    num: "01",
    title: "Јавете се или пишете",
    text: "Контактирајте нè преку телефон, Viber или Instagram.",
  },
  {
    num: "02",
    title: "Кажете ни за приликата",
    text: "Опишете ја приликата и вашите желби — ние ќе ви предложиме.",
  },
  {
    num: "03",
    title: "Подигнете или примете",
    text: "Подигнете го вашиот аранжман од бутикот или организираме достава.",
  },
];
---

<section id="kako-naracuvate" class="bg-mint/30 py-16 md:py-24" aria-label="Како нарачувате">
  <div class="mx-auto max-w-6xl px-4">
    <Reveal>
      <h2 class="font-display text-3xl md:text-4xl text-center text-ink">
        Како нарачувате
      </h2>
    </Reveal>

    <Reveal delay={100}>
      <DrawLine class="mx-auto mt-4 max-w-[200px]" />
    </Reveal>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {steps.map((step, i) => (
        <Reveal delay={i * 120}>
          <div class="text-center">
            <span class="font-display text-4xl text-rose/40">{step.num}</span>
            <h3 class="mt-2 font-display text-xl text-ink">{step.title}</h3>
            <p class="mt-2 text-ink/70">{step.text}</p>
          </div>
        </Reveal>
      ))}
    </div>

    <Reveal delay={400}>
      <div class="mt-10 text-center">
        <a
          href={site.phoneHref}
          class="inline-flex items-center justify-center rounded bg-rose px-6 py-3 text-base font-medium text-cream transition-colors hover:bg-rose-deep"
        >
          Јавете се: {site.phoneFormatted}
        </a>
      </div>
    </Reveal>
  </div>
</section>
