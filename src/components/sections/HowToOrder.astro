---
import { site } from "../../data/site";
import { copy } from "../../data/copy";
import Reveal from "../motion/Reveal.astro";
import DrawLine from "../motion/DrawLine.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";
import SectionDivider from "../ui/SectionDivider.astro";

const t = copy.howToOrder;
---

<section id="kako-naracuvate" class="bg-mint/40 pb-20 pt-10 lg:pb-28 lg:pt-14" aria-labelledby="kako-title">
  <SectionDivider class="mb-10 lg:mb-14" />
  <div class="mx-auto max-w-6xl px-4 lg:grid lg:grid-cols-[5fr_7fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHeading id="kako-title" title={t.heading} intro={t.intro} alignLeftLg />
      <div class="mt-8 hidden lg:block" data-reveal style="--reveal-delay: 200ms">
        <a
          href={site.phoneHref}
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded bg-rose-ink px-6 py-3 text-base font-medium text-cream transition-colors hover:bg-rose-ink-hover"
        >
          <Icon name="phone" />
          {t.cta} {site.phoneFormatted}
        </a>
      </div>
    </div>

    <ol class="mx-auto mt-12 max-w-md lg:mx-0 lg:mt-2 lg:max-w-none" role="list">
      {t.steps.map((step, i) => (
        <li>
          {i > 0 && <DrawLine variant="botanical" class="mx-auto my-8 w-48 lg:mx-0 lg:my-10 lg:w-64" />}
          <Reveal delay={80}>
            <div class="text-center lg:flex lg:gap-8 lg:text-left">
              <span class="block font-display text-5xl leading-none text-rose-ink lg:w-16 lg:flex-none lg:text-6xl" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="mt-3 font-display text-2xl text-ink lg:mt-1 lg:text-3xl">{step.title}</h3>
                <p class="mt-2 text-base leading-relaxed text-ink/80 lg:text-lg">{step.text}</p>
              </div>
            </div>
          </Reveal>
        </li>
      ))}
    </ol>

    <div class="mt-12 text-center lg:hidden" data-reveal>
      <a
        href={site.phoneHref}
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded bg-rose-ink px-6 py-3 text-base font-medium text-cream transition-colors hover:bg-rose-ink-hover"
      >
        <Icon name="phone" />
        {t.cta} {site.phoneFormatted}
      </a>
    </div>
  </div>
</section>
