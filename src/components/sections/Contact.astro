---
import { site } from "../../data/site";
import { copy } from "../../data/copy";
import SectionHeading from "../ui/SectionHeading.astro";
import ContactLinks from "../ui/ContactLinks.astro";
import MapCard from "../ui/MapCard.astro";
import Icon from "../ui/Icon.astro";

const t = copy.contact;

// Call and message carry equal weight (raised cards, 56px round targets);
// the visit card is flat and quieter.
const raised = "rounded-lg bg-cream p-6 shadow-[0_1px_0_rgb(58_51_48/0.06)] ring-1 ring-ink/5";
const eyebrow = "font-body text-xs font-semibold uppercase tracking-[0.18em] text-rose-ink";
---

<section id="kontakt" class="bg-lilac/40 py-20 lg:py-28" aria-labelledby="kontakt-title">
  <div class="mx-auto max-w-6xl px-4">
    <SectionHeading id="kontakt-title" title={t.heading} />

    <div class="mx-auto mt-12 grid max-w-md gap-4 md:max-w-none md:grid-cols-3 md:gap-5 lg:mt-16" data-reveal-stagger>
      <div class={raised} data-reveal>
        <h3 class={eyebrow}>{t.call}</h3>
        <a href={site.phoneHref} class="group mt-4 flex items-center gap-4">
          <span class="flex h-14 w-14 flex-none items-center justify-center rounded-full bg-rose-ink text-cream shadow-sm transition-colors group-hover:bg-rose-ink-hover">
            <Icon name="phone" size="xl" />
          </span>
          <span class="whitespace-nowrap font-display text-[1.75rem] leading-none text-ink transition-colors group-hover:text-rose-ink sm:text-3xl">
            {site.phoneFormatted}
          </span>
        </a>
      </div>

      <div class={raised} data-reveal>
        <h3 class={eyebrow}>{t.message}</h3>
        <ContactLinks channels={["viber", "whatsapp", "instagram"]} class="mt-4" />
      </div>

      <div class="rounded-lg p-6 ring-1 ring-ink/10" data-reveal>
        <h3 class={eyebrow}>{t.visit}</h3>
        <ul class="mt-4 space-y-3 text-ink/85" role="list">
          <li class="flex gap-3">
            <Icon name="place" class="mt-0.5 text-rose-ink" />
            <span>{site.address.full}</span>
          </li>
          <li class="flex gap-3">
            <Icon name="schedule" class="mt-0.5 text-rose-ink" />
            <span>
              <span class="sr-only">{t.hoursLabel}: </span>
              {site.hours.map((h) => (
                <span class="block">
                  <span class="whitespace-nowrap">{h.days}</span> <span class="whitespace-nowrap">{h.time}</span>
                </span>
              ))}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mx-auto mt-4 max-w-md md:mt-5 md:max-w-none" data-reveal>
      <MapCard />
    </div>
  </div>
</section>
