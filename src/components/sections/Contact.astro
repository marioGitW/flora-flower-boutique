---
import { site } from "../../data/site";
import { copy } from "../../data/copy";
import Reveal from "../motion/Reveal.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ContactIcon from "../ui/ContactIcon.astro";

const t = copy.contact;

type Row = {
  icon: "phone" | "viber" | "whatsapp" | "instagram" | "pin";
  label: string;
  value: string;
  href: string;
  external?: boolean;
};

const rows: Row[] = [
  { icon: "phone", label: t.phoneLabel, value: site.phoneFormatted, href: site.phoneHref },
  { icon: "viber", label: t.viber, value: t.viberAction, href: site.viberHref },
  { icon: "whatsapp", label: t.whatsapp, value: t.whatsappAction, href: site.whatsappHref, external: true },
  { icon: "instagram", label: t.instagram, value: site.instagram, href: site.instagramUrl, external: true },
  { icon: "pin", label: t.addressLabel, value: site.address.full, href: site.mapUrl, external: true },
];

const hours = site.hours?.map((h) => (h.days ? `${h.days}: ${h.time}` : h.time)) ?? [t.hoursPending];
---

<section id="kontakt" class="bg-lilac/40 lg:grid lg:grid-cols-2" aria-labelledby="kontakt-title">
  <div class="px-4 py-20 lg:flex lg:justify-end lg:py-28 lg:pl-8 lg:pr-16">
    <div class="mx-auto w-full max-w-md lg:mx-0">
      <SectionHeading id="kontakt-title" title={t.heading} intro={t.intro} alignLeftLg />

      <Reveal delay={200}>
        <ul class="mt-10 divide-y divide-ink/10 overflow-hidden rounded-lg bg-cream/80 ring-1 ring-ink/5" role="list">
          {rows.map((r) => (
            <li>
              <a
                href={r.href}
                {...(r.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                class="group flex min-h-14 items-center gap-4 px-4 py-3 transition-colors hover:bg-white/70"
              >
                <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-blush text-rose-ink">
                  <ContactIcon name={r.icon} size={20} />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm text-ink/75">{r.label}</span>
                  <span class="block font-medium text-ink group-hover:text-rose-ink">{r.value}</span>
                </span>
              </a>
            </li>
          ))}
          <li class="flex min-h-14 items-center gap-4 px-4 py-3">
            <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-butter text-ink/80">
              <ContactIcon name="clock" size={20} />
            </span>
            <span>
              <span class="block text-sm text-ink/75">{t.hoursLabel}</span>
              {hours.map((h) => <span class="block font-medium text-ink">{h}</span>)}
            </span>
          </li>
        </ul>
      </Reveal>
    </div>
  </div>

  <div class="flora-map-frame relative aspect-[4/3] w-full bg-mint/60 lg:aspect-auto lg:min-h-[36rem]">
    <iframe
      src={site.mapEmbedUrl}
      title={t.mapTitle}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
      class="absolute inset-0 h-full w-full border-0"
    ></iframe>
  </div>
</section>

<style>
  /* Ring drawn over the map while keyboard focus is inside it (see script). */
  .flora-map-frame.has-focus::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 3px solid var(--color-rose-ink);
    pointer-events: none;
  }
</style>

<script>
  // The map is a cross-origin frame: once focus moves into it the parent page's
  // :focus / :focus-within never match, so CSS alone can't show a focus ring.
  // The window blurs when focus enters the frame — use that to draw the ring.
  const frame = document.querySelector<HTMLElement>(".flora-map-frame");
  const map = frame?.querySelector("iframe");
  if (frame && map) {
    window.addEventListener("blur", () => {
      requestAnimationFrame(() => frame.classList.toggle("has-focus", document.activeElement === map));
    });
    window.addEventListener("focus", () => frame.classList.remove("has-focus"));
    document.addEventListener("focusin", () => frame.classList.remove("has-focus"));
  }
</script>
