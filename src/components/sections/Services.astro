---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import { site } from "../../data/site";
import { copy } from "../../data/copy";
import Reveal from "../motion/Reveal.astro";
import BloomSvg from "../motion/BloomSvg.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import OrderSheet from "../ui/OrderSheet.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const gallery = await getCollection("gallery");

// Pastels echo the shop's painted panelling; they also sit behind
// background-removed photos when those replace the current ones.
const wells = ["bg-blush", "bg-mint", "bg-butter", "bg-lilac"];

const cards = services.map((s, i) => ({
  id: s.id,
  name: s.data.name,
  description: s.data.description,
  photo: gallery.find((g) => g.data.category === s.id)?.data,
  well: wells[i % wells.length],
  // First two span two columns on desktop: 2 + 2 + 8 singles = three full rows of four.
  wide: i < 2,
}));
---

<section id="uslugi" class="bg-cream py-20 lg:py-28" aria-labelledby="uslugi-title">
  <div class="mx-auto max-w-6xl px-4">
    <div class="lg:flex lg:items-end lg:justify-between lg:gap-12">
      <SectionHeading id="uslugi-title" title={copy.services.heading} alignLeftLg />
      <Reveal delay={140} class="lg:max-w-md">
        <p class="mx-auto mt-5 max-w-md text-center text-lg leading-relaxed text-ink/80 lg:mt-0 lg:text-left">
          {copy.services.intro}
        </p>
      </Reveal>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-16 lg:grid-cols-4 lg:gap-5" role="list">
      {cards.map((card, i) => (
        <li class:list={[card.wide && "lg:col-span-2"]}>
          <Reveal delay={(i % 4) * 70} fill>
            <a
              href={site.phoneHref}
              data-order={card.name}
              class:list={[
                "group flex h-full flex-col overflow-hidden rounded-lg bg-white/60 shadow-[0_1px_0_rgb(58_51_48/0.06)] ring-1 ring-ink/5 transition-shadow hover:shadow-md",
                card.wide && "lg:flex-row",
              ]}
            >
              <div
                class:list={[
                  "flora-panel relative aspect-[4/5] overflow-hidden",
                  card.well,
                  card.wide && "lg:aspect-auto lg:w-1/2 lg:min-h-80",
                ]}
              >
                {card.photo ? (
                  <Picture
                    src={card.photo.src}
                    alt=""
                    formats={["avif", "webp"]}
                    fallbackFormat="webp"
                    widths={[200, 300, 420, 600]}
                    sizes={card.wide ? "(min-width: 1024px) 280px, 46vw" : "(min-width: 1024px) 270px, 46vw"}
                    quality={70}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center">
                    <BloomSvg size={72} petalCount={i % 2 ? 5 : 6} color={i % 2 ? "var(--color-sage)" : "var(--color-rose)"} />
                  </div>
                )}
              </div>
              <div class:list={["flex flex-1 flex-col p-3 sm:p-4", card.wide && "lg:justify-center lg:p-8"]}>
                <h3 class:list={["font-display text-lg leading-snug text-ink sm:text-xl", card.wide && "lg:text-3xl"]}>
                  {card.name}
                </h3>
                <p class:list={["mt-1.5 text-sm leading-relaxed text-ink/80", card.wide && "lg:mt-3 lg:text-base"]}>
                  {card.description}
                </p>
                <span class="mt-auto pt-3">
                  <span class="inline-flex items-center gap-1 rounded-full bg-rose-ink px-3 py-1.5 text-sm font-medium text-cream transition-colors group-hover:bg-rose-ink-hover">
                    {copy.services.orderLabel}
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
                  </span>
                </span>
              </div>
            </a>
          </Reveal>
        </li>
      ))}
    </ul>
  </div>

  <OrderSheet />
</section>
