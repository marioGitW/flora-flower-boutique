---
import { getCollection } from "astro:content";
import { copy } from "../../data/copy";
import Reveal from "../motion/Reveal.astro";
import Icon from "../ui/Icon.astro";
import BloomSvg from "../motion/BloomSvg.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SectionDivider from "../ui/SectionDivider.astro";
import DeferredPicture from "../ui/DeferredPicture.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const gallery = await getCollection("gallery");

// Pastels echo the shop's painted panelling; they also sit behind
// background-removed photos when those replace the current ones.
const wells = ["bg-blush", "bg-mint", "bg-butter", "bg-lilac"];

const cards = services.map((s, i) => ({
  id: s.id,
  name: s.data.name,
  description: s.data.description,
  photo: gallery.find((g) => g.data.category === s.id)?.data,
  well: wells[i % wells.length],
  // First two span two columns on desktop: 2 + 2 + 8 singles = three full rows of four.
  wide: i < 2,
}));
---

<section id="uslugi" class="relative z-10 rounded-t-[1.75rem] bg-cream pb-20 pt-10 shadow-[0_-24px_48px_-24px_rgb(58_51_48/0.25)] lg:pb-28 lg:pt-14" aria-labelledby="uslugi-title">
  <SectionDivider bloom class="mb-10 lg:mb-14" />
  <div class="mx-auto max-w-6xl px-4">
    <div class="lg:flex lg:items-end lg:justify-between lg:gap-12">
      <SectionHeading id="uslugi-title" title={copy.services.heading} alignLeftLg />
      <Reveal delay={140} class="lg:max-w-md">
        <p class="mx-auto mt-5 max-w-md text-center text-lg leading-relaxed text-ink/80 lg:mt-0 lg:text-left">
          {copy.services.intro}
        </p>
      </Reveal>
    </div>

    {/* Each card is one link into the gallery, filtered to that service. Cards
        without photos yet open the full gallery. Without JS: a plain jump. */}
    <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-16 lg:grid-cols-4 lg:gap-5" role="list" data-reveal-stagger>
      {cards.map((card, i) => (
        <li class:list={[card.wide && "lg:col-span-2"]} data-reveal>
          <a
            href="#galerija"
            data-gallery-filter={card.id}
            aria-label={`${card.name}: ${copy.services.cardAction}`}
            aria-describedby={`usluga-${card.id}`}
            class:list={[
              "group flex h-full flex-col overflow-hidden rounded-lg bg-white/60 shadow-[0_1px_0_rgb(58_51_48/0.06)] ring-1 ring-ink/5 transition-[box-shadow,background-color] duration-200 hover:bg-white hover:shadow-md hover:ring-rose/40 focus-visible:bg-white focus-visible:shadow-md",
              card.wide && "lg:flex-row",
            ]}
          >
            <div
              class:list={[
                "flora-panel relative aspect-[4/5] overflow-hidden",
                card.well,
                card.wide && "lg:aspect-auto lg:w-1/2 lg:min-h-80",
              ]}
            >
              {card.photo ? (
                <DeferredPicture
                  src={card.photo.src}
                  alt=""
                  widths={[200, 320, 480, 600]}
                  sizes={card.wide ? "(min-width: 1024px) 280px, 46vw" : "(min-width: 1024px) 270px, 46vw"}
                  quality={55}
                  reveal
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] group-focus-visible:scale-[1.03]"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <BloomSvg size={72} petalCount={i % 2 ? 5 : 6} color={i % 2 ? "var(--color-sage)" : "var(--color-rose)"} />
                </div>
              )}
            </div>
            <div class:list={["flex flex-1 flex-col p-3 sm:p-4", card.wide && "lg:justify-center lg:p-8"]}>
              <h3 class:list={["font-display text-lg leading-snug text-ink sm:text-xl", card.wide && "lg:text-3xl"]}>
                {card.name}
              </h3>
              <p id={`usluga-${card.id}`} class:list={["mt-1.5 text-sm leading-relaxed text-ink/80", card.wide && "lg:mt-3 lg:text-base"]}>
                {card.description}
              </p>
              {/* Quiet cue that the card leads somewhere; nudges on hover/focus. */}
              <Icon
                name="arrow"
                class="mt-auto self-end pt-2 text-rose-ink transition-transform duration-200 group-hover:translate-x-1 group-focus-visible:translate-x-1"
              />
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
