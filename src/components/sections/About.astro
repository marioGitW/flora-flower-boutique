---
import { Picture } from "astro:assets";
import { copy } from "../../data/copy";
import { images } from "../../data/images";
import Reveal from "../motion/Reveal.astro";
import BloomSvg from "../motion/BloomSvg.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const t = copy.about;
---

<section id="za-nas" class="bg-butter/40 lg:grid lg:min-h-[90svh] lg:grid-cols-2" aria-labelledby="za-nas-title">
  {/* The painted panelling and ribbon wall are the brand; the photo runs edge to edge. */}
  <div class="relative aspect-[4/5] max-h-[80svh] w-full overflow-hidden sm:aspect-[4/3] lg:aspect-auto lg:max-h-none">
    <Picture
      src={images.about}
      alt={t.imageAlt}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[390, 560, 727]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      quality={70}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-[50%_40%]"
    />
  </div>

  <div class="flex items-center px-4 py-16 sm:py-20 lg:px-16 lg:py-24 xl:px-24">
    <div class="mx-auto max-w-md lg:mx-0 lg:max-w-lg">
      <SectionHeading id="za-nas-title" title={t.heading} alignLeftLg />
      <div class="mt-8 space-y-4 text-center text-lg leading-relaxed text-ink/85 lg:text-left">
        {t.paragraphs.map((p, i) => (
          <Reveal delay={140 + i * 70}>
            <p class:list={[i === 0 && "font-display text-2xl leading-snug text-ink"]}>{p}</p>
          </Reveal>
        ))}
      </div>
      <div class="mt-10 flex justify-center lg:justify-start">
        <BloomSvg size={56} petalCount={8} />
      </div>
    </div>
  </div>
</section>
