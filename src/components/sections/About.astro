---
import { site } from "../../data/site";
import Reveal from "../motion/Reveal.astro";
import DrawLine from "../motion/DrawLine.astro";
import BloomSvg from "../motion/BloomSvg.astro";
---

<section id="za-nas" class="bg-butter/30 py-16 md:py-24" aria-label="За нас">
  <div class="mx-auto max-w-6xl px-4">
    <Reveal>
      <h2 class="font-display text-3xl md:text-4xl text-center text-ink">За нас</h2>
    </Reveal>

    <Reveal delay={100}>
      <DrawLine class="mx-auto mt-4 max-w-[200px]" />
    </Reveal>

    <div class="mt-12 mx-auto max-w-2xl text-center">
      <Reveal delay={200}>
        <BloomSvg size={56} petalCount={8} class="mx-auto mb-6" />
      </Reveal>

      <Reveal delay={300}>
        <p class="text-lg text-ink/80 leading-relaxed">
          {site.nameFull} е бутик за цвеќе и подароци во {site.address.city}.
          Создаваме уникатни цветни аранжмани за секој посебен момент во вашиот живот.
        </p>
      </Reveal>

      <Reveal delay={400}>
        <p class="mt-4 text-ink/60">
          Со внимание кон деталите и љубов кон цвеќето, секој аранжман е изработен
          специјално за вас.
        </p>
      </Reveal>
    </div>
  </div>
</section>
