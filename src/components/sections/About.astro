---
import { Picture } from "astro:assets";
import { copy } from "../../data/copy";
import { images } from "../../data/images";
import SectionHeading from "../ui/SectionHeading.astro";

const t = copy.about;
---

{/*
  Who Flora is, led by two customer moments in an offset collage. The photos
  are ~770px originals, so they stay at collage size where they are sharp.

  The collage box keeps a fixed ratio and both photos are placed in it by
  percentage, so nothing shifts as they load. Car: 70% of the width, 4:5,
  top left. Bride: 50%, 4:5, bottom right, overlapping the car's lower
  corner by a third of its own height. That gives a box 100 wide and
  87.5 + 62.5 * 2/3 ≈ 129.2 tall.

  Motion: each photo wipes in once as it arrives (data-reveal="wipe",
  src/scripts/reveal.ts), and while the collage is on screen the two drift a
  few percent in opposite directions with the scroll. Both sit on separate
  wrappers so the two never fight over one transform.
*/}
<section id="za-nas" class="flora-about overflow-x-clip bg-butter/40 py-20 lg:py-28" aria-labelledby="za-nas-title">
  <div class="mx-auto max-w-6xl px-4 min-[900px]:grid min-[900px]:grid-cols-2 min-[900px]:items-center min-[900px]:gap-16">
    <div class="flora-moments mx-auto w-full max-w-md min-[900px]:max-w-none" data-moments>
      <div class="flora-moments__photo flora-moments__car" data-moment-drift="-1">
        <div class="h-full overflow-hidden rounded-lg" data-reveal="wipe">
          <Picture
            src={images.moments.car}
            alt={t.photos.car}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[280, 400, 560, 770]}
            sizes="(min-width: 1200px) 380px, (min-width: 900px) 32vw, min(70vw, 314px)"
            quality={70}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
      <div class="flora-moments__photo flora-moments__bride" data-moment-drift="1">
        <div
          class="h-full overflow-hidden rounded-lg shadow-[0_18px_40px_-12px_rgb(58_51_48/0.35)] ring-4 ring-cream"
          data-reveal="wipe"
          style="--reveal-delay: 180ms"
        >
          <Picture
            src={images.moments.bride}
            alt={t.photos.bride}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[220, 320, 480, 640]}
            sizes="(min-width: 1200px) 272px, (min-width: 900px) 23vw, min(50vw, 224px)"
            quality={70}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>

    <div class="mx-auto mt-14 max-w-md text-center min-[900px]:mx-0 min-[900px]:mt-0 min-[900px]:max-w-lg min-[900px]:text-left">
      <SectionHeading id="za-nas-title" title={t.heading} alignLeft900 />
      <p
        class="mt-6 font-display text-3xl italic leading-snug text-ink lg:text-4xl"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        {t.statement}
      </p>
      <p class="mt-5 text-lg leading-relaxed text-ink/85" data-reveal style="--reveal-delay: 200ms">
        {t.body}
      </p>
      <ul
        class="mt-7 flex flex-wrap justify-center gap-2 min-[900px]:justify-start"
        role="list"
        data-reveal
        style="--reveal-delay: 260ms"
      >
        {
          t.tags.map((tag) => (
            <li class="rounded-full bg-cream/80 px-3.5 py-1.5 text-sm text-ink/85 ring-1 ring-rose/40">{tag}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Not laid out until it nears the viewport. Besides the rendering work,
     this keeps the italic Playfair (only used by the statement line) from
     downloading at page load next to the headline fonts. The remembered
     size keeps the scrollbar steady once it has been shown. */
  .flora-about {
    content-visibility: auto;
    /* Roughly its real height (measured ~1180px at 390px, ~900px at 1440px). */
    contain-intrinsic-size: auto 1180px;
  }
  @media (min-width: 900px) {
    .flora-about {
      contain-intrinsic-size: auto 900px;
    }
  }

  .flora-moments {
    position: relative;
    aspect-ratio: 100 / 129.2;
  }

  .flora-moments__photo {
    position: absolute;
    aspect-ratio: 4 / 5;
  }

  .flora-moments__car {
    top: 0;
    left: 0;
    width: 70%;
  }

  .flora-moments__bride {
    right: 0;
    bottom: 0;
    width: 50%;
  }

  /* Scroll drift over the collage's whole trip through the viewport: the car
     rises, the bride sinks. Transform only, on the wrappers. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .flora-moments {
        view-timeline: --flora-moments block;
      }
      .flora-moments__car {
        animation: flora-moment-rise linear both;
        animation-timeline: --flora-moments;
        animation-range: cover;
      }
      .flora-moments__bride {
        animation: flora-moment-sink linear both;
        animation-timeline: --flora-moments;
        animation-range: cover;
      }
    }
  }

  @keyframes flora-moment-rise {
    from {
      transform: translateY(4%);
    }
    to {
      transform: translateY(-4%);
    }
  }

  @keyframes flora-moment-sink {
    from {
      transform: translateY(-5%);
    }
    to {
      transform: translateY(5%);
    }
  }
</style>

<script>
  // Fallback where CSS scroll timelines are missing: the same drift, from the
  // collage's trip through the viewport (0 as its top enters at the bottom,
  // 1 as its bottom leaves at the top). Listens only while on screen.
  const collage = document.querySelector<HTMLElement>("[data-moments]");

  if (
    collage &&
    !CSS.supports("animation-timeline", "view()") &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    // [photo, % at the start, % at the end], matching the keyframes above.
    const photos = [...collage.querySelectorAll<HTMLElement>("[data-moment-drift]")].map((el) =>
      el.dataset.momentDrift === "-1" ? ([el, 4, -4] as const) : ([el, -5, 5] as const),
    );
    let frame = 0;

    const update = () => {
      frame = 0;
      const { top, height } = collage.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.min(1, Math.max(0, (vh - top) / (vh + height)));
      for (const [el, from, to] of photos) {
        el.style.transform = `translate3d(0, ${(from + (to - from) * p).toFixed(2)}%, 0)`;
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    new IntersectionObserver((entries) => {
      const visible = entries[entries.length - 1].isIntersecting;
      if (visible) {
        addEventListener("scroll", schedule, { passive: true });
        addEventListener("resize", schedule, { passive: true });
      } else {
        removeEventListener("scroll", schedule);
        removeEventListener("resize", schedule);
        cancelAnimationFrame(frame);
        frame = 0;
      }
      update();
    }).observe(collage);
  }
</script>
