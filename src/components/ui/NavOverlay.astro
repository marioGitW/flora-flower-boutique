---
import { site } from "../../data/site";
import { copy } from "../../data/copy";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const t = copy.nav;
---

<header id="flora-header" class="fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow] duration-300 lg:bg-cream/90 lg:backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4">
    {/* 40px tall in a 64px bar: 12px clear space above and below. */}
    <a href="#pocetok" class="-mx-1 flex-none rounded px-1 py-1" aria-label={t.home} data-nav-logo>
      <Logo variant="wordmark" height={40} loading="eager" />
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label={t.label}>
      {t.links.map((link) => (
        <a href={link.href} class="text-[0.9375rem] text-ink/85 transition-colors hover:text-rose-ink">{link.label}</a>
      ))}
    </nav>

    <a
      href={site.phoneHref}
      class="hidden min-h-10 items-center gap-2 rounded-full bg-rose-ink px-4 text-sm font-medium text-cream transition-colors hover:bg-rose-ink-hover md:inline-flex"
    >
      <Icon name="phone" size="sm" />
      {t.headerCall} {site.phoneFormatted}
    </a>

    <button
      type="button"
      class="js-only relative z-50 -mr-2 flex h-11 w-11 items-center justify-center rounded-full md:hidden"
      aria-label={t.open}
      aria-expanded="false"
      aria-controls="flora-nav-overlay"
      data-label-open={t.open}
      data-label-close={t.close}
      id="flora-menu-toggle"
    >
      <span class="flora-burger relative text-ink" aria-hidden="true">
        <Icon name="menu" size="lg" class="flora-burger-open" />
        <Icon name="close" size="lg" class="flora-burger-close absolute inset-0" />
      </span>
    </button>
  </div>

  <div
    id="flora-nav-overlay"
    class="flora-nav-overlay fixed inset-0 z-40 flex flex-col items-center justify-center gap-7 bg-cream md:hidden"
    inert
  >
    <nav aria-label={t.label}>
      <ul class="flex flex-col items-center gap-5" role="list">
        {t.links.map((link) => (
          <li>
            <a href={link.href} class="flora-nav-link font-display text-3xl text-ink transition-colors hover:text-rose-ink">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={site.phoneHref} class="flora-nav-link mt-2 inline-flex min-h-12 items-center gap-2 rounded bg-rose-ink px-6 text-base font-medium text-cream">
      <Icon name="phone" />
      {copy.hero.callLabel} {site.phoneFormatted}
    </a>
  </div>
</header>

<style>
  /* Menu and close glyphs cross-fade with a quarter turn. */
  .flora-burger :global(svg) {
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s;
  }
  .flora-burger :global(.flora-burger-close) {
    opacity: 0;
    transform: rotate(-90deg);
  }
  [aria-expanded="true"] .flora-burger :global(.flora-burger-open) {
    opacity: 0;
    transform: rotate(90deg);
  }
  [aria-expanded="true"] .flora-burger :global(.flora-burger-close) {
    opacity: 1;
    transform: none;
  }
  /* Visible at once on open (so focus can land), hidden only after the fade on close. */
  .flora-nav-overlay {
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .flora-nav-overlay.is-open {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0s;
  }
  #flora-header.is-scrolled {
    background-color: rgb(251 247 242 / 0.95);
    box-shadow: 0 1px 0 rgb(58 51 48 / 0.06);
  }
</style>

<script>
  import { trapTab } from "../../scripts/focus-trap";

  const header = document.getElementById("flora-header")!;
  const toggle = document.getElementById("flora-menu-toggle") as HTMLButtonElement;
  const overlay = document.getElementById("flora-nav-overlay")!;
  const logo = header.querySelector<HTMLElement>("[data-nav-logo]")!;
  const links = [...overlay.querySelectorAll<HTMLAnchorElement>("a")];
  let open = false;
  // Elements we made inert on open — others (e.g. a tucked sticky bar) keep their own state.
  let madeInert: Element[] = [];

  // Everything outside the header, plus the logo hidden under the overlay.
  const outside = () => [...document.body.children].filter((el) => el !== header).concat(logo);

  function setOpen(next: boolean, { restoreFocus = true } = {}) {
    if (next === open) return;
    open = next;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "");
    overlay.classList.toggle("is-open", open);
    overlay.toggleAttribute("inert", !open);
    if (open) {
      madeInert = outside().filter((el) => !el.hasAttribute("inert"));
      for (const el of madeInert) el.setAttribute("inert", "");
    } else {
      for (const el of madeInert) el.removeAttribute("inert");
      madeInert = [];
    }
    document.documentElement.classList.toggle("scroll-lock", open);

    if (open) links[0]?.focus();
    else if (restoreFocus) toggle.focus();
  }

  toggle.addEventListener("click", () => setOpen(!open));

  // Following a link: close, but let focus travel with the navigation.
  for (const link of links) link.addEventListener("click", () => setOpen(false, { restoreFocus: false }));

  document.addEventListener("keydown", (e) => {
    if (!open) return;
    if (e.key === "Escape") {
      e.preventDefault();
      setOpen(false);
      return;
    }
    // Header holds the toggle and the overlay; the logo under it is inert.
    trapTab(header, e);
  });

  // Closing the menu if the viewport grows past the mobile breakpoint.
  matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false, { restoreFocus: false });
  });

  const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 24);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
