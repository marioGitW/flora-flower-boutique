---
import Reveal from "../motion/Reveal.astro";
import DrawLine from "../motion/DrawLine.astro";

interface Props {
  id: string;
  title: string;
  intro?: string;
  /** Left-align from lg up (editorial two-column sections). */
  alignLeftLg?: boolean;
  /** Same, from 900px, for sections that go two-column there. */
  alignLeft900?: boolean;
  class?: string;
}

const { id, title, intro, alignLeftLg = false, alignLeft900 = false, class: className = "" } = Astro.props;
const align = alignLeft900 ? "text-center min-[900px]:text-left" : alignLeftLg ? "text-center lg:text-left" : "text-center";
const lineAlign = alignLeft900 ? "mx-auto min-[900px]:mx-0" : alignLeftLg ? "mx-auto lg:mx-0" : "mx-auto";
---

<div class:list={[align, className]}>
  <Reveal>
    <h2 id={id} class="font-display text-4xl leading-tight text-ink md:text-5xl">{title}</h2>
  </Reveal>
  <DrawLine variant="botanical" delay={70} class:list={["mt-3 w-40", lineAlign]} />
  {intro && (
    <Reveal delay={140}>
      <p class:list={["mt-5 max-w-md text-lg leading-relaxed text-ink/80", lineAlign]}>{intro}</p>
    </Reveal>
  )}
</div>
