---
import { site } from "../../data/site";
import ContactIcon from "./ContactIcon.astro";
import { copy } from "../../data/copy";
---

<div
  class="fixed bottom-0 inset-x-0 z-40 flex gap-3 bg-cream/95 px-4 py-3 shadow-[0_-2px_12px_rgba(58,51,48,0.08)] backdrop-blur-sm md:hidden"
  role="navigation"
  aria-label={copy.nav.quickContact}
>
  <a
    href={site.phoneHref}
    class="flex flex-1 items-center justify-center gap-2 rounded bg-rose-ink py-3.5 text-base font-medium text-cream transition-colors hover:bg-rose-ink-hover active:bg-rose-ink-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-ink"
  >
    <ContactIcon name="phone" />
    {copy.nav.stickyCall}
  </a>
  <a
    href={site.viberHref}
    class="flex flex-1 items-center justify-center gap-2 rounded bg-viber py-3.5 text-base font-medium text-cream transition-colors hover:bg-viber-hover active:bg-viber-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-viber"
  >
    <ContactIcon name="viber" />
    {copy.nav.stickyViber}
  </a>
</div>

<!-- Spacer to prevent content from hiding behind the bar on mobile -->
<div class="h-[72px] md:hidden" aria-hidden="true"></div>
