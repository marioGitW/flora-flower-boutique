---
import { site } from "../../data/site";
---

<div
  class="fixed bottom-0 inset-x-0 z-40 flex gap-3 bg-cream/95 px-4 py-3 shadow-[0_-2px_12px_rgba(58,51,48,0.08)] backdrop-blur-sm md:hidden"
  role="navigation"
  aria-label="Брз контакт"
>
  <a
    href={site.phoneHref}
    class="flex flex-1 items-center justify-center gap-2 rounded bg-rose py-3.5 text-base font-medium text-cream transition-colors hover:bg-rose-deep active:bg-rose-deep"
  >
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M2 3a1 1 0 0 1 1-1h3.28a1 1 0 0 1 .95.68l1.07 3.21a1 1 0 0 1-.45 1.15l-1.4.93a11.05 11.05 0 0 0 5.13 5.13l.93-1.4a1 1 0 0 1 1.15-.45l3.21 1.07a1 1 0 0 1 .68.95V17a1 1 0 0 1-1 1A15 15 0 0 1 2 3Z" />
    </svg>
    Повикај
  </a>
  <a
    href={site.viberHref}
    class="flex flex-1 items-center justify-center gap-2 rounded bg-[#7360F2] py-3.5 text-base font-medium text-cream transition-colors hover:bg-[#5f4ed4] active:bg-[#5f4ed4]"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.006 2C6.491 2 2.991 5.527 2.991 10.02c0 2.413.87 4.395 2.514 5.87l.004 2.746a.75.75 0 0 0 1.15.636l2.244-1.39a9.603 9.603 0 0 0 3.103.51c5.515 0 9.015-3.527 9.015-8.02-.003-4.499-3.5-8.372-9.015-8.372Zm4.39 10.963a6.116 6.116 0 0 1-2.783 1.837c-.573.168-1.17.091-1.693-.158l-.652-.366a13.757 13.757 0 0 1-2.56-2.063 13.751 13.751 0 0 1-2.064-2.561l-.365-.652c-.25-.523-.326-1.12-.158-1.693a6.116 6.116 0 0 1 1.837-2.783.505.505 0 0 1 .664-.025l1.488 1.17a.504.504 0 0 1 .14.591l-.56 1.258a.3.3 0 0 0 .054.308l2.385 2.385a.3.3 0 0 0 .308.054l1.258-.56a.504.504 0 0 1 .591.14l1.17 1.488a.505.505 0 0 1-.025.664l-.035.036Z" />
    </svg>
    Viber
  </a>
</div>

<!-- Spacer to prevent content from hiding behind the bar on mobile -->
<div class="h-[72px] md:hidden" aria-hidden="true"></div>
