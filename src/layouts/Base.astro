---
import "@fontsource-variable/playfair-display";
// Italic only for the За нас statement line; fetched only where it's used.
import "@fontsource-variable/playfair-display/wght-italic.css";
import "@fontsource-variable/inter";
import "../styles/global.css";
// The hero's two faces, Cyrillic, every weight in one variable file each:
// Playfair for the headline, Inter for the kicker, lead and buttons. The
// Fontsource CSS points at these same files, so the preloads are the ones used.
// Both arrive before first paint, so the centred hero copy doesn't jump.
import displayFontUrl from "@fontsource-variable/playfair-display/files/playfair-display-cyrillic-wght-normal.woff2?url";
import bodyFontUrl from "@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url";
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.meta.title, description = site.meta.description } =
  Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Structured data wants a photo of the work, not the logo.
const productPhoto = await getEntry("gallery", "mixed-bouquet");
const schemaImage = productPhoto
  ? new URL((await getImage({ src: productPhoto.data.src, width: 1200, format: "jpg" })).src, Astro.site).toString()
  : new URL(site.meta.ogImage, Astro.site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Florist",
  name: site.nameFull,
  alternateName: [site.nameMaps, site.nameEn],
  description: description,
  url: Astro.site?.toString(),
  // International format drops the trunk 0; phoneHref already has it right.
  telephone: site.phoneHref.replace("tel:", ""),
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressCountry: "MK",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: site.openingHours.days,
    opens: site.openingHours.opens,
    closes: site.openingHours.closes,
  },
  hasMap: site.mapUrl,
  sameAs: [site.instagramUrl],
  image: schemaImage,
};
---

<!doctype html>
<html lang="mk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FBF7F2" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(site.meta.ogImage, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="mk_MK" />
    <meta property="og:site_name" content={site.nameFull} />

    {/* JSON-LD */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-dvh bg-cream text-ink font-body antialiased">
    <slot />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
