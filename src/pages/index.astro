---
import Base from "../layouts/Base.astro";
import NavOverlay from "../components/ui/NavOverlay.astro";
import StickyCallBar from "../components/ui/StickyCallBar.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import MarqueeBand from "../components/sections/MarqueeBand.astro";
import Gallery from "../components/sections/Gallery.astro";
import HowToOrder from "../components/sections/HowToOrder.astro";
import About from "../components/sections/About.astro";
import Contact from "../components/sections/Contact.astro";
import ContactLinks from "../components/ui/ContactLinks.astro";
import { site } from "../data/site";
import { copy } from "../data/copy";
---

<Base>
  <NavOverlay />

  <main>
    <Hero />
    <Services />
    <MarqueeBand />
    <Gallery />
    <HowToOrder />
    <About />
    <Contact />
  </main>

  <footer class="flora-footer bg-ink py-12 text-cream/80">
    <div class="mx-auto max-w-6xl px-4 text-center" data-reveal>
      <p class="font-display text-2xl text-cream">{site.name}</p>
      <p class="mt-1 font-display">{site.tagline}</p>
      <ContactLinks channels={["phone", "viber", "whatsapp", "instagram"]} size="md" class="mt-6 justify-center" />
      <p class="mt-6 text-xs text-cream/75">
        &copy; {new Date().getFullYear()} {site.nameFull}. {copy.footer.rights}
      </p>
    </div>
  </footer>

  <StickyCallBar />
</Base>

<style>
  .flora-footer :focus-visible {
    outline-color: var(--color-cream);
  }
</style>
